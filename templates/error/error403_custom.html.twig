{% extends 'base.html.twig' %}

{% block title %}Accès Refusé{% endblock %}

{% block body %}
<div class="container text-center my-5 py-5">
    <div class="card shadow border-danger mx-auto" style="max-width: 500px;">
        <div class="card-body p-4">
            <h1 class="display-1 text-danger font-weight-bold">403</h1>
            <h3 class="card-title text-dark mb-3">Accès Refusé</h3>
            
            <div class="alert alert-danger" role="alert">
                <strong>Échec :</strong> vous n'avez pas accès à cette ressource.
            </div>

            <p class="text-muted small mb-4">
                Cette zone est réservée aux utilisateurs disposant des rôles  <code>Correct</code>.
            </p>

            <a href="{{ path('app_home') }}" class="btn btn-primary">
                Retour à l'accueil
            </a>
            
            <a href="{{ path('app_logout') }}" class="btn btn-info">
                Deconnexion
            </a>
        </div>
    </div>
</div>
{% endblock %}