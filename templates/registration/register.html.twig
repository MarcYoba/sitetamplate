{% extends 'base.html.twig' %}

{% block title %}Inscription - Gestion Trésorerie{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center align-items-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0" style="border-radius: 16px; overflow: hidden;">
                
                {# En-tête Midnight Blue & Gold #}
                <div class="card-header text-center py-4" style="background-color: #0F172A; border-bottom: 3px solid #D4AF37;">
                    <h3 class="text-white fw-bold mb-1">
                        <i class="fas fa-user-plus me-2" style="color: #D4AF37;"></i>Créer un compte
                    </h3>
                    <p class="text-muted small mb-0">Renseignez vos informations pour accéder à la plateforme</p>
                </div>

                <div class="card-body p-4 p-sm-5 bg-white">
                    {# Affichage des erreurs globales #}
                    {% if form_errors(registrationForm) %}
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            {{ form_errors(registrationForm) }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endif %}

                    {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}

                    <div class="row g-3">
                        {# Nom complet #}
                        <div class="col-12">
                            {{ form_label(registrationForm.nom, null, {'label_attr': {'class': 'form-label fw-bold text-dark'}}) }}
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="fas fa-user" style="color: #D4AF37;"></i>
                                </span>
                                {{ form_widget(registrationForm.nom, {'attr': {'class': 'form-control border-start-0' ~ (registrationForm.nom.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            </div>
                            <div class="invalid-feedback d-block">
                                {{ form_errors(registrationForm.nom) }}
                            </div>
                        </div>

                        {# Email #}
                        <div class="col-12">
                            {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'form-label fw-bold text-dark'}}) }}
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="fas fa-envelope" style="color: #D4AF37;"></i>
                                </span>
                                {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control border-start-0' ~ (registrationForm.email.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            </div>
                            <div class="invalid-feedback d-block">
                                {{ form_errors(registrationForm.email) }}
                            </div>
                        </div>

                        {# Téléphone #}
                        <div class="col-md-6">
                            {{ form_label(registrationForm.telephone, null, {'label_attr': {'class': 'form-label fw-bold text-dark'}}) }}
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="fas fa-phone" style="color: #D4AF37;"></i>
                                </span>
                                {{ form_widget(registrationForm.telephone, {'attr': {'class': 'form-control border-start-0' ~ (registrationForm.telephone.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            </div>
                            <div class="invalid-feedback d-block">
                                {{ form_errors(registrationForm.telephone) }}
                            </div>
                        </div>

                        {# Adresse #}
                        <div class="col-md-6">
                            {{ form_label(registrationForm.adresse, null, {'label_attr': {'class': 'form-label fw-bold text-dark'}}) }}
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="fas fa-map-marker-alt" style="color: #D4AF37;"></i>
                                </span>
                                {{ form_widget(registrationForm.adresse, {'attr': {'class': 'form-control border-start-0' ~ (registrationForm.adresse.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            </div>
                            <div class="invalid-feedback d-block">
                                {{ form_errors(registrationForm.adresse) }}
                            </div>
                        </div>

                        {# Mot de passe #}
                        <div class="col-12">
                            {{ form_label(registrationForm.plainPassword, null, {'label_attr': {'class': 'form-label fw-bold text-dark'}}) }}
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="fas fa-lock" style="color: #D4AF37;"></i>
                                </span>
                                {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control border-start-0' ~ (registrationForm.plainPassword.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            </div>
                            <div class="invalid-feedback d-block">
                                {{ form_errors(registrationForm.plainPassword) }}
                            </div>
                        </div>

                        {# Conditions d'utilisation #}
                        <div class="col-12 my-2">
                            <div class="form-check">
                                {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input' ~ (registrationForm.agreeTerms.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                                {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'form-check-label text-muted small'}}) }}
                            </div>
                            <div class="invalid-feedback d-block">
                                {{ form_errors(registrationForm.agreeTerms) }}
                            </div>
                        </div>
                    </div>

                    {# Bouton de soumission #}
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-lg text-white font-weight-bold shadow-sm" style="background-color: #0F172A; border-left: 4px solid #D4AF37;">
                            <i class="fas fa-check-circle me-2" style="color: #D4AF37;"></i> Finaliser l'inscription
                        </button>
                    </div>

                    {{ form_end(registrationForm) }}
                </div>

                {# Pied de carte avec lien vers Connexion #}
                <div class="card-footer text-center bg-light py-3">
                    <span class="text-muted small">Vous avez déjà un compte ?</span>
                    <a href="{{ path('app_login') }}" class="fw-bold text-decoration-none ms-1" style="color: #0F172A;">
                        Se connecter
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
{% endblock %}